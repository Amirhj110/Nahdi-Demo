# Server-only. Never prefix these with VITE_ — they must not reach the browser.
IDRAK_BASE_URL=https://idrak.bilyticaglobal.com
# Public agent key for /api/public/agents/ask; chat key remains a compatibility fallback.
IDRAK_AGENT_KEY=
IDRAK_CHAT_API_KEY=
IDRAK_API_KEY=
# Optional agent metadata.
IDRAK_AGENT_ID=agt-1791273705542-awzfqk
# Optional comma-separated extra origins (localhost is always allowed)
# IDRAK_ALLOWED_ORIGINS=https://your-demo-host.example
# LiveKit realtime token service. REALTIME_TOKEN_API_KEY takes precedence.
REALTIME_TOKEN_API_KEY=
VOICE_SERVER_API_KEY=
VOICE_TOKEN_BASE_URL=https://voice-realtime.bilyticaglobal.com
VOICE_SERVER_BASE_URL=

# Server-only Gemini Vision key for the cosmetic skin-scan endpoint.
GEMINI_VISION_API_KEY=
# Optional server-only DermIQ key; the Google Vision provider can be used when this is not configured.
DERMIQ_API_KEY=